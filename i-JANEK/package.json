{
  "name": "i-janek",
  "version": "0.1.34",
  "private": true,
  "description": "i-JANEK desktop supervision platform for Master/Slave IT support workflows.",
  "author": "i-JANICKI",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "vue-tsc --noEmit && electron-vite build && electron-builder",
    "build:dir": "vue-tsc --noEmit && electron-vite build && electron-builder --dir",
    "build:web": "vue-tsc --noEmit && vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "signing:macos:setup": "node scripts/setup-macos-signing.mjs",
    "signing:macos:check": "node scripts/check-macos-signing.mjs",
    "test:rules": "npx --yes firebase-tools@15.11.0 emulators:exec --config ../firebase.json --only firestore,database --project demo-i-janicki \"node --test tests/firebase-rules.test.mjs\"",
    "build:prepare-icons": "./scripts/prepare-icons.sh",
    "build:macos:app": "./scripts/build-macos-app.sh",
    "build:macos:installer": "./scripts/build-macos-installer.sh",
    "build:win:exe:from-macos": "./scripts/build-windows-exe-from-macos.sh",
    "build:installers:from-macos": "./scripts/build-release-macos.sh",
    "build:release:from-macos": "./scripts/build-release-macos.sh",
    "release": "./release.sh",
    "release:test": "node scripts/release-channel.mjs test",
    "release:beta": "node scripts/release-channel.mjs beta",
    "release:stable": "node scripts/release-channel.mjs stable",
    "release:test:preview": "node scripts/release-channel.mjs test --dry-run",
    "release:beta:preview": "node scripts/release-channel.mjs beta --dry-run",
    "release:stable:preview": "node scripts/release-channel.mjs stable --dry-run"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "dayjs": "^1.11.13",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.3.9",
    "firebase": "^11.6.1",
    "lucide-vue-next": "^0.511.0",
    "mime-types": "^3.0.1",
    "node-machine-id": "^1.1.12",
    "pinia": "^3.0.3",
    "systeminformation": "^5.25.11",
    "uuid": "^11.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "autoprefixer": "^10.4.21",
    "electron": "^35.1.4",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vue-tsc": "^2.2.8"
  }
}
