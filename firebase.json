{
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      "firebase-debug.log",
      ".firebase/**",
      "**/node_modules/**",
      "i-JANEK/**",
      "postcss.config.js",
      "package.json",
      "package-lock.json"
    ],
    "redirects": [
      { "source": "/oferta/cennik", "destination": "/cennik/", "type": 301 },
      { "source": "/oferta/cennik/", "destination": "/cennik/", "type": 301 },
      { "source": "/oferta/wroclaw", "destination": "/lokalizacje/wroclaw/", "type": 301 },
      { "source": "/oferta/wroclaw/", "destination": "/lokalizacje/wroclaw/", "type": 301 },
      { "source": "/oferta/sroda-slaska", "destination": "/lokalizacje/sroda-slaska/", "type": 301 },
      { "source": "/oferta/sroda-slaska/", "destination": "/lokalizacje/sroda-slaska/", "type": 301 },
      { "source": "/oferta/miekinia-lutynia", "destination": "/lokalizacje/miekinia-lutynia/", "type": 301 },
      { "source": "/oferta/miekinia-lutynia/", "destination": "/lokalizacje/miekinia-lutynia/", "type": 301 }
    ],
    "headers": [
      {
        "source": "firmy/**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "firma/**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.min.js",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.min.css",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.@(woff|woff2|ttf|eot)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|ico|webp|avif)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "firmy/**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex" }
        ]
      },
      {
        "source": "firma/**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex" }
        ]
      },
      {
        "source": "stats/**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex" }
        ]
      },
      {
        "source": "kalkulator/**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex" }
        ]
      },
      {
        "source": "Szablony/**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex" }
        ]
      }
    ]
  }
}
