rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMaster() {
      return isAuthenticated()
        && request.auth.token.email != null
        && request.auth.token.email == 'igor.janicki27@gmail.com';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAllowedAnalyticsType(type) {
      return type == 'page_visit'
        || type == 'tutorial_complete'
        || type == 'session_duration';
    }

    function hasAnalyticsDuration() {
      return request.resource.data.keys().hasAny(['durationSeconds']);
    }

    function isValidAnalyticsEvent() {
      return request.resource.data.keys().hasOnly([
          'type',
          'path',
          'timestamp',
          'page',
          'source',
          'durationSeconds'
        ])
        && request.resource.data.keys().hasAll(['type', 'path', 'timestamp'])
        && request.resource.data.type is string
        && isAllowedAnalyticsType(request.resource.data.type)
        && request.resource.data.path is string
        && request.resource.data.timestamp is timestamp
        && (
          !request.resource.data.keys().hasAny(['page'])
          || request.resource.data.page is string
        )
        && (
          !request.resource.data.keys().hasAny(['source'])
          || request.resource.data.source is string
        )
        && (
          (request.resource.data.type == 'session_duration' && hasAnalyticsDuration())
          || (request.resource.data.type != 'session_duration' && !hasAnalyticsDuration())
        )
        && (
          !hasAnalyticsDuration()
          || (
            request.resource.data.durationSeconds is int
            && request.resource.data.durationSeconds >= 0
            && request.resource.data.durationSeconds <= 7200
          )
        );
    }

    function isCreatingOwnDevice() {
      return isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.token.email != null
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.approvalStatus == 'pending';
    }

    function isDeviceOwner() {
      return isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    function ownerCanUpdateDevice() {
      return isDeviceOwner()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'machineId',
          'hostname',
          'platform',
          'arch',
          'appVersion',
          'deviceAlias',
          'aliasCustomizedAt',
          'updatedAt',
          'lastSeenAt',
          'telemetry',
          'offline',
          'inventoryCapturedAt',
          'inventoryReportUrl',
          'backupSnapshot',
          'backupSyncProgress',
          'backupPolicy',
          'consent',
          'consentAcceptedAt',
          'monitoringEnabled',
          'lastHandledUpdateRequestId',
          'lastUpdateResult',
          'rustdesk'
        ]);
    }

    function isCreatingOwnEvent() {
      return isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;
    }

    function isPinFormat(pin) {
      return pin is string && pin.matches('^\\d{4,6}$');
    }

    function isAdminPin(pin) {
      return pin == '151100';
    }

    function isPinLocked(pin) {
      return exists(/databases/$(database)/documents/firmy_pin_locks/$(pin))
        && get(/databases/$(database)/documents/firmy_pin_locks/$(pin)).data.isLocked == true;
    }

    function firmyMaxAttempts() {
      return exists(/databases/$(database)/documents/firmy_settings/default)
        && get(/databases/$(database)/documents/firmy_settings/default).data.maxAttempts is int
        && get(/databases/$(database)/documents/firmy_settings/default).data.maxAttempts >= 1
        && get(/databases/$(database)/documents/firmy_settings/default).data.maxAttempts <= 20
        ? get(/databases/$(database)/documents/firmy_settings/default).data.maxAttempts
        : 5;
    }

    function hasActiveFirmyPin(pin) {
      return isPinFormat(pin)
        && !isPinLocked(pin)
        && (
          isAdminPin(pin)
          || (
            exists(/databases/$(database)/documents/firmy_pins/$(pin))
            && get(/databases/$(database)/documents/firmy_pins/$(pin)).data.isActive == true
          )
        );
    }

    function hasFirmySession() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/firmy_sessions/$(request.auth.uid));
    }

    function firmySessionPin() {
      return get(/databases/$(database)/documents/firmy_sessions/$(request.auth.uid)).data.pin;
    }

    function isFirmyAdmin() {
      return hasFirmySession()
        && hasActiveFirmyPin(firmySessionPin())
        && (
          isAdminPin(firmySessionPin())
          || get(/databases/$(database)/documents/firmy_pins/$(firmySessionPin())).data.role == 'admin'
        );
    }

    function isFirmyClientFor(clientId) {
      return hasFirmySession()
        && hasActiveFirmyPin(firmySessionPin())
        && exists(/databases/$(database)/documents/firmy_pins/$(firmySessionPin()))
        && get(/databases/$(database)/documents/firmy_pins/$(firmySessionPin())).data.role == 'client'
        && get(/databases/$(database)/documents/firmy_pins/$(firmySessionPin())).data.clientId == clientId;
    }

    match /analytics_events/{id} {
      allow list: if true;
      allow create: if isValidAnalyticsEvent();
    }

    match /reviews/{id} {
      allow get: if resource.data.approved == true;
      allow list: if true;
      allow create: if request.resource.data.keys().hasOnly([
          'name',
          'email',
          'comment',
          'rating',
          'timestamp',
          'approved'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'email',
          'comment',
          'rating',
          'timestamp',
          'approved'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.comment is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.timestamp is timestamp
        && request.resource.data.approved == false;
      allow update: if resource.data.approved == false
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['approved'])
        && request.resource.data.approved == true;
    }

    match /calculator_orders/{orderId} {
      allow read, write: if true;
    }

    match /devices/{deviceId} {
      allow read: if isMaster() || isDeviceOwner();
      allow create: if isMaster() || isCreatingOwnDevice();
      allow update: if isMaster() || ownerCanUpdateDevice();
      allow delete: if isMaster() || isDeviceOwner();
    }

    match /clients/{clientId} {
      allow read: if isMaster() || isOwner(clientId);
      allow create, update: if isMaster()
        || (
          isOwner(clientId)
          && request.resource.data.keys().hasOnly([
            'uid',
            'email',
            'displayName',
            'photoURL',
            'role',
            'createdAt',
            'updatedAt',
            'lastLoginAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.displayName is string
          && request.resource.data.role in ['master', 'slave']
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt is int
          && request.resource.data.lastLoginAt is int
        );
      allow delete: if isMaster() || isOwner(clientId);
    }

    match /events/{eventId} {
      allow read: if isMaster() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
      allow create: if isMaster() || isCreatingOwnEvent();
    }

    match /firmy_sessions/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'pin',
          'role',
          'clientId',
          'clientSlug',
          'lastLoginAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && hasActiveFirmyPin(request.resource.data.pin)
        && (
          isAdminPin(request.resource.data.pin)
          || (
            exists(/databases/$(database)/documents/firmy_pins/$(request.resource.data.pin))
            && (
              !request.resource.data.keys().hasAny(['role'])
              || request.resource.data.role
                == get(/databases/$(database)/documents/firmy_pins/$(request.resource.data.pin)).data.role
            )
            && (
              !request.resource.data.keys().hasAny(['clientId'])
              || request.resource.data.clientId
                == get(/databases/$(database)/documents/firmy_pins/$(request.resource.data.pin)).data.clientId
            )
            && (
              !request.resource.data.keys().hasAny(['clientSlug'])
              || request.resource.data.clientSlug
                == get(/databases/$(database)/documents/firmy_pins/$(request.resource.data.pin)).data.clientSlug
            )
          )
        );
      allow delete: if isOwner(uid) || isFirmyAdmin();
    }

    match /firmy_pin_locks/{pin} {
      allow get: if isAuthenticated() && isPinFormat(pin);
      allow list: if isFirmyAdmin();
      allow create: if (
          isAuthenticated()
          && isPinFormat(pin)
          && !exists(/databases/$(database)/documents/firmy_pin_locks/$(pin))
          && request.resource.data.keys().hasOnly([
            'pin',
            'failedAttempts',
            'isLocked',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.pin == pin
          && request.resource.data.failedAttempts is int
          && request.resource.data.failedAttempts >= 1
          && request.resource.data.failedAttempts <= 20
          && request.resource.data.isLocked == (request.resource.data.failedAttempts >= firmyMaxAttempts())
        );
      allow update: if isFirmyAdmin()
        || (
          isAuthenticated()
          && isPinFormat(pin)
          && request.resource.data.keys().hasOnly([
            'pin',
            'failedAttempts',
            'isLocked',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.pin == pin
          && resource.data.pin == pin
          && request.resource.data.failedAttempts is int
          && request.resource.data.failedAttempts == resource.data.failedAttempts + 1
          && request.resource.data.failedAttempts <= 20
          && (
            request.resource.data.isLocked == true
            || request.resource.data.failedAttempts < firmyMaxAttempts()
          )
        );
      allow delete: if isFirmyAdmin();
    }

    match /firmy_pins/{pin} {
      allow get: if isFirmyAdmin() || (isAuthenticated() && isPinFormat(pin));
      allow list: if isFirmyAdmin();
      allow create, update: if isFirmyAdmin()
        && request.resource.data.keys().hasAll(['role'])
        && (
          request.resource.data.role != 'admin'
          || pin == '151100'
        );
      allow delete: if isFirmyAdmin() && pin != '151100';
    }

    match /firmy_settings/{settingId} {
      allow get: if isAuthenticated();
      allow list: if isFirmyAdmin();
      allow create, update, delete: if isFirmyAdmin();
    }

    match /firmy_clients/{clientId} {
      allow get: if isFirmyAdmin() || isFirmyClientFor(clientId);
      allow list: if isFirmyAdmin();
      allow create, update, delete: if isFirmyAdmin();

      match /months/{monthId} {
        allow get: if isFirmyAdmin() || isFirmyClientFor(clientId);
        allow list: if false;
        allow create, update, delete: if isFirmyAdmin();
      }

      match /expenses/{expenseId} {
        allow get, list: if isFirmyAdmin() || isFirmyClientFor(clientId);
        allow create, update, delete: if isFirmyAdmin();
      }
    }

    // Czaty, komendy, presence i telemetry dzialaja w Realtime Database,
    // wiec nie sa objete regulami Firestore z tego pliku.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
