rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMaster() {
      return isAuthenticated()
        && request.auth.token.email != null
        && request.auth.token.email == 'kontakt@i-janicki.pl';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAllowedAnalyticsType(type) {
      return type == 'page_visit'
        || type == 'tutorial_complete'
        || type == 'session_duration'
        || type == 'contact_click';
    }

    function isAllowedContactChannel(channel) {
      return channel == 'phone'
        || channel == 'whatsapp'
        || channel == 'facebook'
        || channel == 'contact_page'
        || channel == 'email';
    }

    function hasAnalyticsDuration() {
      return request.resource.data.keys().hasAny(['durationSeconds']);
    }

    function isValidAnalyticsEvent() {
      return request.resource.data.keys().hasOnly([
          'type',
          'path',
          'timestamp',
          'page',
          'source',
          'durationSeconds',
          'channel'
        ])
        && request.resource.data.keys().hasAll(['type', 'path', 'timestamp'])
        && request.resource.data.type is string
        && isAllowedAnalyticsType(request.resource.data.type)
        && request.resource.data.path is string
        && request.resource.data.timestamp is timestamp
        && (
          !request.resource.data.keys().hasAny(['page'])
          || request.resource.data.page is string
        )
        && (
          !request.resource.data.keys().hasAny(['source'])
          || request.resource.data.source is string
        )
        && (
          (request.resource.data.type == 'contact_click'
            && request.resource.data.keys().hasAny(['channel'])
            && request.resource.data.channel is string
            && isAllowedContactChannel(request.resource.data.channel))
          || (request.resource.data.type != 'contact_click'
            && !request.resource.data.keys().hasAny(['channel']))
        )
        && (
          (request.resource.data.type == 'session_duration' && hasAnalyticsDuration())
          || (request.resource.data.type != 'session_duration' && !hasAnalyticsDuration())
        )
        && (
          !hasAnalyticsDuration()
          || (
            request.resource.data.durationSeconds is int
            && request.resource.data.durationSeconds >= 0
            && request.resource.data.durationSeconds <= 7200
          )
        );
    }

    function isCreatingOwnDevice() {
      return isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.token.email != null
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.approvalStatus == 'pending'
        && (
          !request.resource.data.keys().hasAny(['updateChannel'])
          || request.resource.data.updateChannel == 'stable'
        );
    }

    function isDeviceOwner() {
      return isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    function ownerCanUpdateDwService() {
      return !request.resource.data.diff(resource.data).changedKeys().hasAny(['dwservice'])
        || (
          resource.data.keys().hasAll(['dwservice'])
          && resource.data.dwservice is map
          && request.resource.data.dwservice is map
          && request.resource.data.dwservice.installationCode == resource.data.dwservice.installationCode
          && request.resource.data.dwservice.configurationId == resource.data.dwservice.configurationId
          && request.resource.data.dwservice.requestedAt == resource.data.dwservice.requestedAt
          && request.resource.data.dwservice.requestedBy == resource.data.dwservice.requestedBy
          && request.resource.data.dwservice.status in ['pending', 'installing', 'ready', 'error']
          && request.resource.data.dwservice.diff(resource.data.dwservice).changedKeys().hasOnly([
            'configurationId',
            'status',
            'updatedAt',
            'appliedCodeHash',
            'error'
          ])
        );
    }

    function ownerCanUpdateDevice() {
      return isDeviceOwner()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'machineId',
          'hostname',
          'platform',
          'arch',
          'appVersion',
          'deviceAlias',
          'aliasCustomizedAt',
          'updatedAt',
          'lastSeenAt',
          'telemetry',
          'offline',
          'inventoryCapturedAt',
          'inventoryReportId',
          'backupSnapshot',
          'backupSyncProgress',
          'backupPolicy',
          'contactName',
          'companyName',
          'installationLocation',
          'consent',
          'consentAcceptedAt',
          'monitoringEnabled',
          'lastHandledUpdateRequestId',
          'lastUpdateResult',
          'dwservice'
        ])
        && ownerCanUpdateDwService();
    }

    function isCreatingOwnEvent() {
      return isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;
    }

    function isPinFormat(pin) {
      return pin is string && pin.matches('^\\d{4,6}$');
    }

    function isAdminPin(pin) {
      return pin == '151100';
    }

    function isPinLocked(pin) {
      return exists(/databases/$(database)/documents/firmy_pin_locks/$(pin))
        && get(/databases/$(database)/documents/firmy_pin_locks/$(pin)).data.isLocked == true;
    }

    function firmyMaxAttempts() {
      return exists(/databases/$(database)/documents/firmy_settings/default)
        && get(/databases/$(database)/documents/firmy_settings/default).data.maxAttempts is int
        && get(/databases/$(database)/documents/firmy_settings/default).data.maxAttempts >= 1
        && get(/databases/$(database)/documents/firmy_settings/default).data.maxAttempts <= 20
        ? get(/databases/$(database)/documents/firmy_settings/default).data.maxAttempts
        : 5;
    }

    function hasActiveFirmyPin(pin) {
      return isPinFormat(pin)
        && !isPinLocked(pin)
        && (
          isAdminPin(pin)
          || (
            exists(/databases/$(database)/documents/firmy_pins/$(pin))
            && get(/databases/$(database)/documents/firmy_pins/$(pin)).data.isActive == true
          )
        );
    }

    function hasFirmySession() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/firmy_sessions/$(request.auth.uid));
    }

    function firmySessionPin() {
      return get(/databases/$(database)/documents/firmy_sessions/$(request.auth.uid)).data.pin;
    }

    function isFirmyAdmin() {
      return hasFirmySession()
        && hasActiveFirmyPin(firmySessionPin())
        && (
          isAdminPin(firmySessionPin())
          || get(/databases/$(database)/documents/firmy_pins/$(firmySessionPin())).data.role == 'admin'
        );
    }

    function isFirmyClientFor(clientId) {
      return hasFirmySession()
        && hasActiveFirmyPin(firmySessionPin())
        && exists(/databases/$(database)/documents/firmy_pins/$(firmySessionPin()))
        && get(/databases/$(database)/documents/firmy_pins/$(firmySessionPin())).data.role == 'client'
        && get(/databases/$(database)/documents/firmy_pins/$(firmySessionPin())).data.clientId == clientId;
    }

    function statsSettingsExists() {
      return exists(/databases/$(database)/documents/stats_settings/default);
    }

    function statsPinHash() {
      return get(/databases/$(database)/documents/stats_settings/default).data.pinHash;
    }

    function statsMaxAttempts() {
      return statsSettingsExists()
        && get(/databases/$(database)/documents/stats_settings/default).data.maxAttempts is int
        && get(/databases/$(database)/documents/stats_settings/default).data.maxAttempts >= 1
        && get(/databases/$(database)/documents/stats_settings/default).data.maxAttempts <= 10
        ? get(/databases/$(database)/documents/stats_settings/default).data.maxAttempts
        : 3;
    }

    function statsLockMinutes() {
      return statsSettingsExists()
        && get(/databases/$(database)/documents/stats_settings/default).data.lockMinutes is int
        && get(/databases/$(database)/documents/stats_settings/default).data.lockMinutes >= 1
        && get(/databases/$(database)/documents/stats_settings/default).data.lockMinutes <= 60
        ? get(/databases/$(database)/documents/stats_settings/default).data.lockMinutes
        : 5;
    }

    function hasActiveStatsSession() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/stats_sessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/stats_sessions/$(request.auth.uid)).data.unlockUntil is timestamp
        && get(/databases/$(database)/documents/stats_sessions/$(request.auth.uid)).data.unlockUntil > request.time;
    }

    match /analytics_events/{id} {
      allow list: if hasActiveStatsSession();
      allow create: if isValidAnalyticsEvent();
    }

    match /reviews/{id} {
      // Legacy collection. Reviews now come from Google Business Profile.
      // Keep historical documents private and block all client-side writes.
      allow read, write: if false;
    }

    match /contact_form_stats/total {
      allow get: if hasActiveStatsSession();
      // Counters are written only by the authenticated retention worker.
      allow list, create, update, delete: if false;
    }

    match /contact_leads/{leadId} {
      allow get, list: if isMaster();
      allow create: if request.resource.data.keys().hasOnly([
          'firstName',
          'lastName',
          'email',
          'consentAcceptedDates'
        ])
        && request.resource.data.keys().hasAll([
          'firstName',
          'lastName',
          'email',
          'consentAcceptedDates'
        ])
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
        && request.resource.data.consentAcceptedDates is list
        && request.resource.data.consentAcceptedDates.size() >= 1;
      allow update: if request.resource.data.keys().hasOnly([
          'firstName',
          'lastName',
          'email',
          'consentAcceptedDates'
        ])
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.email == resource.data.email
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
        && request.resource.data.consentAcceptedDates is list
        && request.resource.data.consentAcceptedDates.size() >= resource.data.consentAcceptedDates.size();
    }

    match /calculator_orders/{orderId} {
      allow read, write: if true;
    }

    match /calculator_orders_pin2/{orderId} {
      allow read, write: if true;
    }

    match /devices/{deviceId} {
      allow read: if isMaster() || isDeviceOwner();
      allow create: if isMaster() || isCreatingOwnDevice();
      allow update: if isMaster() || ownerCanUpdateDevice();
      allow delete: if isMaster() || isDeviceOwner();
    }

    match /inventoryReports/{deviceId} {
      function isValidOwnedInventoryReport() {
        return isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'reportId',
          'ownerUid',
          'deviceId',
          'capturedAt',
          'updatedAt',
          'schemaVersion',
          'installedAppsCount',
          'installedAppsChunkCount',
          'windowsUpdatesCount',
          'windowsUpdatesChunkCount'
        ])
        && request.resource.data.keys().hasAll([
          'reportId',
          'ownerUid',
          'deviceId',
          'capturedAt',
          'updatedAt',
          'schemaVersion',
          'installedAppsCount',
          'installedAppsChunkCount',
          'windowsUpdatesCount',
          'windowsUpdatesChunkCount'
        ])
        && request.resource.data.reportId == deviceId
        && request.resource.data.deviceId == deviceId
        && request.resource.data.ownerUid == request.auth.uid
        && exists(/databases/$(database)/documents/devices/$(deviceId))
        && get(/databases/$(database)/documents/devices/$(deviceId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/devices/$(deviceId)).data.approvalStatus == 'approved'
        && request.resource.data.capturedAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.schemaVersion == 1
        && request.resource.data.installedAppsCount is int
        && request.resource.data.installedAppsCount >= 0
        && request.resource.data.installedAppsChunkCount is int
        && request.resource.data.installedAppsChunkCount >= 1
        && request.resource.data.installedAppsChunkCount <= 128
        && request.resource.data.windowsUpdatesCount is int
        && request.resource.data.windowsUpdatesCount >= 0
        && request.resource.data.windowsUpdatesChunkCount is int
        && request.resource.data.windowsUpdatesChunkCount >= 1
        && request.resource.data.windowsUpdatesChunkCount <= 128;
      }

      allow read: if isMaster() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidOwnedInventoryReport();
      allow update: if resource.data.ownerUid == request.auth.uid && isValidOwnedInventoryReport();
      allow delete: if isMaster() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);

      match /sections/{sectionId} {
        allow read: if isMaster() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
        allow create, update: if isAuthenticated()
          && request.resource.data.keys().hasOnly([
            'ownerUid',
            'deviceId',
            'capturedAt',
            'kind',
            'chunkIndex',
            'chunkCount',
            'data'
          ])
          && request.resource.data.keys().hasAll([
            'ownerUid',
            'deviceId',
            'capturedAt',
            'kind',
            'chunkIndex',
            'chunkCount',
            'data'
          ])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.deviceId == deviceId
          && request.resource.data.capturedAt is int
          && request.resource.data.kind in ['hardware', 'defender', 'installedApps', 'windowsUpdates']
          && request.resource.data.chunkIndex is int
          && request.resource.data.chunkIndex >= 0
          && request.resource.data.chunkCount is int
          && request.resource.data.chunkCount >= 1
          && request.resource.data.chunkCount <= 128
          && getAfter(/databases/$(database)/documents/inventoryReports/$(deviceId)).data.ownerUid == request.auth.uid
          && (
            (sectionId == 'hardware'
              && request.resource.data.kind == 'hardware'
              && request.resource.data.chunkIndex == 0
              && request.resource.data.chunkCount == 1
              && request.resource.data.data is map)
            || (sectionId == 'defender'
              && request.resource.data.kind == 'defender'
              && request.resource.data.chunkIndex == 0
              && request.resource.data.chunkCount == 1
              && request.resource.data.data is map)
            || (sectionId.matches('^installedApps-[0-9]{3}$')
              && request.resource.data.kind == 'installedApps'
              && request.resource.data.data is list)
            || (sectionId.matches('^windowsUpdates-[0-9]{3}$')
              && request.resource.data.kind == 'windowsUpdates'
              && request.resource.data.data is list)
          );
        allow delete: if isMaster() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
      }
    }

    match /clients/{clientId} {
      allow read: if isMaster() || isOwner(clientId);
      allow create, update: if isMaster()
        || (
          isOwner(clientId)
          && request.resource.data.keys().hasOnly([
            'uid',
            'email',
            'displayName',
            'photoURL',
            'role',
            'companyName',
            'installationLocation',
            'createdAt',
            'updatedAt',
            'lastLoginAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.displayName is string
          && (
            !request.resource.data.keys().hasAny(['companyName'])
            || request.resource.data.companyName is string
          )
          && (
            !request.resource.data.keys().hasAny(['installationLocation'])
            || request.resource.data.installationLocation is string
          )
          && request.resource.data.role in ['master', 'slave']
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt is int
          && request.resource.data.lastLoginAt is int
        );
      allow delete: if isMaster() || isOwner(clientId);
    }

    match /events/{eventId} {
      allow read: if isMaster() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
      allow create: if isMaster() || isCreatingOwnEvent();
      allow delete: if isMaster() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
    }

    match /usageDaily/{rollupId} {
      function hasValidUsageFields() {
        return request.resource.data.keys().hasOnly([
          'ownerUid',
          'deviceId',
          'dayKey',
          'observedSeconds',
          'cpuObservedSeconds',
          'cpuOver80Seconds',
          'gpuObservedSeconds',
          'gpuOver80Seconds',
          'ramObservedSeconds',
          'ramOver80Seconds',
          'diskObservedSeconds',
          'diskOver80Seconds',
          'anyOver80Seconds',
          'restartCount',
          'sampleCount',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'ownerUid',
          'deviceId',
          'dayKey',
          'observedSeconds',
          'cpuObservedSeconds',
          'cpuOver80Seconds',
          'gpuObservedSeconds',
          'gpuOver80Seconds',
          'ramObservedSeconds',
          'ramOver80Seconds',
          'diskObservedSeconds',
          'diskOver80Seconds',
          'anyOver80Seconds',
          'restartCount',
          'sampleCount',
          'updatedAt'
        ])
        && request.resource.data.ownerUid is string
        && request.resource.data.deviceId is string
        && rollupId == request.resource.data.deviceId + '_' + request.resource.data.dayKey
        && request.resource.data.dayKey is string
        && request.resource.data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.observedSeconds is int
        && request.resource.data.observedSeconds >= 0
        && request.resource.data.observedSeconds <= 86400
        && request.resource.data.cpuObservedSeconds is int
        && request.resource.data.cpuObservedSeconds >= 0
        && request.resource.data.cpuObservedSeconds <= request.resource.data.observedSeconds
        && request.resource.data.cpuOver80Seconds is int
        && request.resource.data.cpuOver80Seconds >= 0
        && request.resource.data.cpuOver80Seconds <= request.resource.data.cpuObservedSeconds
        && request.resource.data.gpuObservedSeconds is int
        && request.resource.data.gpuObservedSeconds >= 0
        && request.resource.data.gpuObservedSeconds <= request.resource.data.observedSeconds
        && request.resource.data.gpuOver80Seconds is int
        && request.resource.data.gpuOver80Seconds >= 0
        && request.resource.data.gpuOver80Seconds <= request.resource.data.gpuObservedSeconds
        && request.resource.data.ramObservedSeconds is int
        && request.resource.data.ramObservedSeconds >= 0
        && request.resource.data.ramObservedSeconds <= request.resource.data.observedSeconds
        && request.resource.data.ramOver80Seconds is int
        && request.resource.data.ramOver80Seconds >= 0
        && request.resource.data.ramOver80Seconds <= request.resource.data.ramObservedSeconds
        && request.resource.data.diskObservedSeconds is int
        && request.resource.data.diskObservedSeconds >= 0
        && request.resource.data.diskObservedSeconds <= request.resource.data.observedSeconds
        && request.resource.data.diskOver80Seconds is int
        && request.resource.data.diskOver80Seconds >= 0
        && request.resource.data.diskOver80Seconds <= request.resource.data.diskObservedSeconds
        && request.resource.data.anyOver80Seconds is int
        && request.resource.data.anyOver80Seconds >= 0
        && request.resource.data.anyOver80Seconds <= request.resource.data.observedSeconds
        && request.resource.data.restartCount is int
        && request.resource.data.restartCount >= 0
        && request.resource.data.restartCount <= 50
        && request.resource.data.sampleCount is int
        && request.resource.data.sampleCount >= 1
        && request.resource.data.sampleCount <= 1000
        && request.resource.data.updatedAt is int;
      }

      function isApprovedUsageOwner() {
        return isAuthenticated()
          && request.resource.data.ownerUid == request.auth.uid
          && exists(/databases/$(database)/documents/devices/$(request.resource.data.deviceId))
          && get(/databases/$(database)/documents/devices/$(request.resource.data.deviceId)).data.ownerUid == request.auth.uid
          && get(/databases/$(database)/documents/devices/$(request.resource.data.deviceId)).data.approvalStatus == 'approved';
      }

      allow read: if isMaster() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
      allow create: if isApprovedUsageOwner() && hasValidUsageFields();
      allow update: if isApprovedUsageOwner()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.dayKey == resource.data.dayKey
        && request.resource.data.observedSeconds >= resource.data.observedSeconds
        && request.resource.data.cpuObservedSeconds >= resource.data.cpuObservedSeconds
        && request.resource.data.cpuOver80Seconds >= resource.data.cpuOver80Seconds
        && request.resource.data.gpuObservedSeconds >= resource.data.gpuObservedSeconds
        && request.resource.data.gpuOver80Seconds >= resource.data.gpuOver80Seconds
        && request.resource.data.ramObservedSeconds >= resource.data.ramObservedSeconds
        && request.resource.data.ramOver80Seconds >= resource.data.ramOver80Seconds
        && request.resource.data.diskObservedSeconds >= resource.data.diskObservedSeconds
        && request.resource.data.diskOver80Seconds >= resource.data.diskOver80Seconds
        && request.resource.data.anyOver80Seconds >= resource.data.anyOver80Seconds
        && request.resource.data.restartCount >= resource.data.restartCount
        && request.resource.data.sampleCount > resource.data.sampleCount
        && hasValidUsageFields();
      allow delete: if isMaster();
    }

    match /appConfig/masterSettings {
      allow read: if isAuthenticated();
      allow create, update, delete: if isMaster();
    }

    match /auditLogs/{logId} {
      allow read: if isMaster() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
      allow create: if isMaster()
        || (
          isAuthenticated()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.deviceId is string
          && request.resource.data.action is string
          && request.resource.data.createdAt is int
        );
      allow update, delete: if false;
    }

    match /firmy_sessions/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'pin',
          'role',
          'clientId',
          'clientSlug',
          'lastLoginAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && hasActiveFirmyPin(request.resource.data.pin)
        && (
          isAdminPin(request.resource.data.pin)
          || (
            exists(/databases/$(database)/documents/firmy_pins/$(request.resource.data.pin))
            && (
              !request.resource.data.keys().hasAny(['role'])
              || request.resource.data.role
                == get(/databases/$(database)/documents/firmy_pins/$(request.resource.data.pin)).data.role
            )
            && (
              !request.resource.data.keys().hasAny(['clientId'])
              || request.resource.data.clientId
                == get(/databases/$(database)/documents/firmy_pins/$(request.resource.data.pin)).data.clientId
            )
            && (
              !request.resource.data.keys().hasAny(['clientSlug'])
              || request.resource.data.clientSlug
                == get(/databases/$(database)/documents/firmy_pins/$(request.resource.data.pin)).data.clientSlug
            )
          )
        );
      allow delete: if isOwner(uid) || isFirmyAdmin();
    }

    match /firmy_pin_locks/{pin} {
      allow get: if isAuthenticated() && isPinFormat(pin);
      allow list: if isFirmyAdmin();
      allow create: if (
          isAuthenticated()
          && isPinFormat(pin)
          && !exists(/databases/$(database)/documents/firmy_pin_locks/$(pin))
          && request.resource.data.keys().hasOnly([
            'pin',
            'failedAttempts',
            'isLocked',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.pin == pin
          && request.resource.data.failedAttempts is int
          && request.resource.data.failedAttempts >= 1
          && request.resource.data.failedAttempts <= 20
          && request.resource.data.isLocked == (request.resource.data.failedAttempts >= firmyMaxAttempts())
        );
      allow update: if isFirmyAdmin()
        || (
          isAuthenticated()
          && isPinFormat(pin)
          && request.resource.data.keys().hasOnly([
            'pin',
            'failedAttempts',
            'isLocked',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.pin == pin
          && resource.data.pin == pin
          && request.resource.data.failedAttempts is int
          && request.resource.data.failedAttempts == resource.data.failedAttempts + 1
          && request.resource.data.failedAttempts <= 20
          && (
            request.resource.data.isLocked == true
            || request.resource.data.failedAttempts < firmyMaxAttempts()
          )
        );
      allow delete: if isFirmyAdmin();
    }

    match /firmy_pins/{pin} {
      allow get: if isFirmyAdmin() || (isAuthenticated() && isPinFormat(pin));
      allow list: if isFirmyAdmin();
      allow create, update: if isFirmyAdmin()
        && request.resource.data.keys().hasAll(['role'])
        && (
          request.resource.data.role != 'admin'
          || pin == '151100'
        );
      allow delete: if isFirmyAdmin() && pin != '151100';
    }

    match /firmy_settings/{settingId} {
      allow get: if isAuthenticated();
      allow list: if isFirmyAdmin();
      allow create, update, delete: if isFirmyAdmin();
    }

    match /attachments/{attachmentId} {
      allow get, list: if isFirmyAdmin();
      allow create, update: if isFirmyAdmin()
        && request.resource.data.keys().hasOnly([
          'id',
          'name',
          'type',
          'size',
          'chunkCount',
          'createdAt'
        ])
        && request.resource.data.id == attachmentId
        && request.resource.data.name is string
        && request.resource.data.type is string
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 5 * 1024 * 1024
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount >= 1
        && request.resource.data.chunkCount <= 8
        && request.resource.data.createdAt is string;
      allow delete: if isFirmyAdmin();

      match /chunks/{chunkId} {
        allow get, list: if isFirmyAdmin();
        allow create, update: if isFirmyAdmin()
          && request.resource.data.keys().hasOnly(['index', 'data'])
          && request.resource.data.index is int
          && request.resource.data.index >= 0
          && request.resource.data.index < 8
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 900 * 1024;
        allow delete: if isFirmyAdmin();
      }
    }

    match /firmy_clients/{clientId} {
      allow get: if isFirmyAdmin() || isFirmyClientFor(clientId);
      allow list: if isFirmyAdmin();
      allow create, update, delete: if isFirmyAdmin();

      match /months/{monthId} {
        allow get: if isFirmyAdmin() || isFirmyClientFor(clientId);
        allow list: if false;
        allow create, update, delete: if isFirmyAdmin();
      }

      match /expenses/{expenseId} {
        allow get, list: if isFirmyAdmin() || isFirmyClientFor(clientId);
        allow create, update, delete: if isFirmyAdmin();
      }

      match /post_tabs/{tabId} {
        allow get, list: if isFirmyAdmin() || isFirmyClientFor(clientId);
        allow create, update, delete: if isFirmyAdmin();
      }

      match /posts/{postId} {
        allow get, list: if isFirmyAdmin() || isFirmyClientFor(clientId);
        allow create, update, delete: if isFirmyAdmin();
      }
    }

    match /stats_settings/{settingId} {
      allow get: if false;
      allow list: if false;
      allow create, update, delete: if isMaster();
    }

    match /stats_pin_attempts/{attemptId} {
      allow get: if isOwner(attemptId);
      allow list: if false;
      allow create: if isOwner(attemptId)
        && statsSettingsExists()
        && statsPinHash() is string
        && request.resource.data.keys().hasOnly(['uid', 'pinHash', 'failedAttempts', 'lockUntil', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.pinHash is string
        && request.resource.data.failedAttempts is int
        && request.resource.data.lockUntil is timestamp
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.pinHash == statsPinHash()
            && request.resource.data.failedAttempts == 0
            && request.resource.data.lockUntil <= request.time)
          || (request.resource.data.pinHash != statsPinHash()
            && request.resource.data.failedAttempts == 1
            && request.resource.data.lockUntil <= request.time)
        );
      allow update: if isOwner(attemptId)
        && resource.data.uid == request.auth.uid
        && statsSettingsExists()
        && statsPinHash() is string
        && request.resource.data.keys().hasOnly(['uid', 'pinHash', 'failedAttempts', 'lockUntil', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.pinHash is string
        && request.resource.data.updatedAt == request.time
        && request.resource.data.failedAttempts is int
        && resource.data.lockUntil <= request.time
        && (
          // Success: reset attempts
          (request.resource.data.pinHash == statsPinHash()
            && request.resource.data.failedAttempts == 0
            && request.resource.data.lockUntil <= request.time)
          // Failure: increment attempts and maybe lock
          || (request.resource.data.pinHash != statsPinHash()
            && (
              request.resource.data.failedAttempts == resource.data.failedAttempts + 1
              || (
                resource.data.failedAttempts >= statsMaxAttempts()
                && request.resource.data.failedAttempts == 1
              )
            )
            && (
              request.resource.data.failedAttempts >= statsMaxAttempts()
                ? request.resource.data.lockUntil == request.time + duration.value(statsLockMinutes(), 'm')
                : request.resource.data.lockUntil <= request.time
            ))
        );
      allow delete: if false;
    }

    match /stats_sessions/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid)
        && statsSettingsExists()
        && statsPinHash() is string
        && existsAfter(/databases/$(database)/documents/stats_pin_attempts/$(uid))
        && getAfter(/databases/$(database)/documents/stats_pin_attempts/$(uid)).data.failedAttempts == 0
        && getAfter(/databases/$(database)/documents/stats_pin_attempts/$(uid)).data.lockUntil <= request.time
        && request.resource.data.keys().hasOnly(['uid', 'pinHash', 'unlockUntil', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.pinHash is string
        && request.resource.data.pinHash == statsPinHash()
        && request.resource.data.unlockUntil is timestamp
        && request.resource.data.unlockUntil > request.time
        && request.resource.data.unlockUntil <= request.time + duration.value(12, 'h')
        && request.resource.data.updatedAt == request.time
        ;
      allow delete: if isOwner(uid);
    }

    // Czaty, komendy, presence i telemetry dzialaja w Realtime Database,
    // wiec nie sa objete regulami Firestore z tego pliku.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
