rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMaster() {
      return isAuthenticated()
        && request.auth.token.email != null
        && request.auth.token.email == 'igor.janicki27@gmail.com';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAllowedAnalyticsType(type) {
      return type == 'page_visit'
        || type == 'tutorial_complete'
        || type == 'session_duration';
    }

    function hasAnalyticsDuration() {
      return request.resource.data.keys().hasAny(['durationSeconds']);
    }

    function isValidAnalyticsEvent() {
      return request.resource.data.keys().hasOnly([
          'type',
          'path',
          'timestamp',
          'page',
          'source',
          'durationSeconds'
        ])
        && request.resource.data.keys().hasAll(['type', 'path', 'timestamp'])
        && request.resource.data.type is string
        && isAllowedAnalyticsType(request.resource.data.type)
        && request.resource.data.path is string
        && request.resource.data.timestamp is timestamp
        && (
          !request.resource.data.keys().hasAny(['page'])
          || request.resource.data.page is string
        )
        && (
          !request.resource.data.keys().hasAny(['source'])
          || request.resource.data.source is string
        )
        && (
          (request.resource.data.type == 'session_duration' && hasAnalyticsDuration())
          || (request.resource.data.type != 'session_duration' && !hasAnalyticsDuration())
        )
        && (
          !hasAnalyticsDuration()
          || (
            request.resource.data.durationSeconds is int
            && request.resource.data.durationSeconds >= 0
            && request.resource.data.durationSeconds <= 7200
          )
        );
    }

    function isCreatingOwnDevice() {
      return isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.token.email != null
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.approvalStatus == 'pending';
    }

    function isDeviceOwner() {
      return isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    function ownerCanUpdateDevice() {
      return isDeviceOwner()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'machineId',
          'hostname',
          'platform',
          'arch',
          'appVersion',
          'deviceAlias',
          'aliasCustomizedAt',
          'updatedAt',
          'lastSeenAt',
          'telemetry',
          'offline',
          'inventoryCapturedAt',
          'inventoryReportUrl',
          'backupSnapshot',
          'backupSyncProgress',
          'backupPolicy',
          'consent',
          'consentAcceptedAt',
          'monitoringEnabled',
          'lastHandledUpdateRequestId',
          'lastUpdateResult',
          'rustdesk'
        ]);
    }

    function isCreatingOwnEvent() {
      return isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;
    }

    match /analytics_events/{id} {
      allow list: if true;
      allow create: if isValidAnalyticsEvent();
    }

    match /reviews/{id} {
      allow get: if resource.data.approved == true;
      allow list: if true;
      allow create: if request.resource.data.keys().hasOnly([
          'name',
          'email',
          'comment',
          'rating',
          'timestamp',
          'approved'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'email',
          'comment',
          'rating',
          'timestamp',
          'approved'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.comment is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.timestamp is timestamp
        && request.resource.data.approved == false;
      allow update: if resource.data.approved == false
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['approved'])
        && request.resource.data.approved == true;
    }

    match /calculator_orders/{orderId} {
      allow read, write: if true;
    }

    match /devices/{deviceId} {
      allow read: if isMaster() || isDeviceOwner();
      allow create: if isMaster() || isCreatingOwnDevice();
      allow update: if isMaster() || ownerCanUpdateDevice();
      allow delete: if isMaster() || isDeviceOwner();
    }

    match /clients/{clientId} {
      allow read: if isMaster() || isOwner(clientId);
      allow create, update: if isMaster()
        || (
          isOwner(clientId)
          && request.resource.data.keys().hasOnly([
            'uid',
            'email',
            'displayName',
            'photoURL',
            'role',
            'createdAt',
            'updatedAt',
            'lastLoginAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.displayName is string
          && request.resource.data.role in ['master', 'slave']
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt is int
          && request.resource.data.lastLoginAt is int
        );
      allow delete: if isMaster() || isOwner(clientId);
    }

    match /events/{eventId} {
      allow read: if isMaster() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
      allow create: if isMaster() || isCreatingOwnEvent();
    }

    // Czaty, komendy, presence i telemetry dzialaja w Realtime Database,
    // wiec nie sa objete regulami Firestore z tego pliku.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
